{
  "datasets": [
    {
      "name": "kpi",
      "displayName": "Kpi",
      "queryLines": [
        "SELECT SUM(premium_revenue) AS premium, SUM(losses_paid + reserves) AS claims_cost, SUM(expenses) AS expenses, SUM(underwriting_result) AS underwriting_result, SUM(losses_paid + reserves) / NULLIF(SUM(premium_revenue), 0) AS loss_ratio, SUM(losses_paid + reserves + expenses) / NULLIF(SUM(premium_revenue), 0) AS combined_ratio FROM reporting.finance_reporting"
      ]
    },
    {
      "name": "trend",
      "displayName": "Trend",
      "queryLines": [
        "SELECT to_date(period || '-01') AS period_month, view, loss_ratio, combined_ratio FROM ( SELECT posting_period AS period, 'Booked (posting period)' AS view, SUM(losses_paid + reserves) / NULLIF(SUM(premium_revenue), 0) AS loss_ratio, SUM(losses_paid + reserves + expenses) / NULLIF(SUM(premium_revenue), 0) AS combined_ratio FROM reporting.finance_reporting GROUP BY 1, 2 UNION ALL SELECT origin_period AS period, 'Restated (origin period)' AS view, SUM(losses_paid + reserves) / NULLIF(SUM(premium_revenue), 0) AS loss_ratio, SUM(losses_paid + reserves + expenses) / NULLIF(SUM(premium_revenue), 0) AS combined_ratio FROM reporting.finance_reporting_by_origin GROUP BY 1, 2) WHERE to_date(period || '-01') >= add_months((SELECT to_date(max(posting_period) || '-01') FROM efr.trial_balance), -36)"
      ]
    },
    {
      "name": "lob",
      "displayName": "Lob",
      "queryLines": [
        "SELECT line_of_business, SUM(premium_revenue) AS premium, SUM(losses_paid + reserves) AS claims_cost, SUM(underwriting_result) AS underwriting_result, SUM(losses_paid + reserves + expenses) / NULLIF(SUM(premium_revenue), 0) AS combined_ratio FROM reporting.finance_reporting GROUP BY 1"
      ]
    },
    {
      "name": "tb",
      "displayName": "Tb",
      "queryLines": [
        "SELECT to_date(posting_period || '-01') AS period_month, gl_category, SUM(balance) AS balance FROM efr.trial_balance WHERE to_date(posting_period || '-01') >= add_months((SELECT to_date(max(posting_period) || '-01') FROM efr.trial_balance), -24) GROUP BY 1, 2"
      ]
    },
    {
      "name": "accounts",
      "displayName": "Accounts",
      "queryLines": [
        "SELECT account_code, account_name, gl_category, SUM(balance) AS balance, SUM(posting_count) AS postings FROM efr.trial_balance GROUP BY ALL"
      ]
    },
    {
      "name": "reins",
      "displayName": "Reins",
      "queryLines": [
        "SELECT line_of_business, treaty_type, treaties, ceded_premium, avg_ceded_share FROM efr.reinsurance_ceded"
      ]
    },
    {
      "name": "late_kpi",
      "displayName": "Late Kpi",
      "queryLines": [
        "SELECT COUNT(DISTINCT batch_id) AS late_batches, COUNT(DISTINCT claim_id) AS late_claims, coalesce(SUM(CASE WHEN entry_type = 'PRIOR_PERIOD_ADJ' THEN adjustment END), 0) AS prior_period_adj, coalesce(SUM(CASE WHEN entry_type = 'LATE_ADJ' THEN adjustment END), 0) AS open_period_adj, (SELECT COUNT(*) FROM efr.period_control WHERE status = 'CLOSED') AS closed_periods, (SELECT max(posting_period) FROM efr.period_control WHERE status = 'CLOSED') AS closed_through FROM efr.late_arrival_log"
      ]
    },
    {
      "name": "late_origin",
      "displayName": "Late Origin",
      "queryLines": [
        "SELECT to_date(origin_period || '-01') AS origin_month, entry_type, SUM(adjustment) AS adjustment FROM efr.late_arrival_log GROUP BY ALL"
      ]
    },
    {
      "name": "late_type",
      "displayName": "Late Type",
      "queryLines": [
        "SELECT late_type, gl_category, SUM(adjustment) AS adjustment, COUNT(DISTINCT claim_id) AS claims FROM efr.late_arrival_log GROUP BY ALL"
      ]
    },
    {
      "name": "late_detail",
      "displayName": "Late Detail",
      "queryLines": [
        "SELECT batch_id, booking_date, late_type, entry_type, gl_category, line_of_business, origin_period, posting_period, claims, adjustment, avg_report_lag_days FROM reporting.efr_late_arrival_summary"
      ]
    },
    {
      "name": "restatement",
      "displayName": "Restatement",
      "queryLines": [
        "WITH b AS (SELECT posting_period AS period, SUM(losses_paid + reserves) / NULLIF(SUM(premium_revenue), 0) AS booked FROM reporting.finance_reporting GROUP BY 1), o AS (SELECT origin_period AS period, SUM(losses_paid + reserves) / NULLIF(SUM(premium_revenue), 0) AS restated FROM reporting.finance_reporting_by_origin GROUP BY 1) SELECT o.period, b.booked AS booked_loss_ratio, o.restated AS restated_loss_ratio, (o.restated - b.booked) * 100 AS restatement_pts FROM o JOIN b USING (period) WHERE abs(o.restated - b.booked) > 0.00005 ORDER BY abs(o.restated - b.booked) DESC LIMIT 50"
      ]
    },
    {
      "name": "periods",
      "displayName": "Periods",
      "queryLines": [
        "SELECT posting_period, status, closed_at, closed_by FROM efr.period_control"
      ]
    }
  ],
